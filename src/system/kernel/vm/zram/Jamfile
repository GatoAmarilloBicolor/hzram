# Jamfile del subsistema zram (capa 1 + capa 2).
#
# zram NO es un modulo cargable: se compila dentro del kernel. Los objetos
# generados deben anadirse a KernelMergeObject kernel_vm.o en
# src/system/kernel/vm/Jamfile (T0.6 del plan).

SubDir HAIKU_TOP src system kernel vm zram ;

UsePrivateHeaders shared ;
UseHeaders [ FDirName $(SUBDIR) $(DOTDOT) ] ;

# Capa 1 (nucleo, sin dependencias del kernel) + capa 2 (pegamento Haiku).
KernelMergeObject zram.o :
	zram_core.cpp
	zram_kernel.cpp
	lz4/lz4.c
;

OBJECTS zram.o ;
